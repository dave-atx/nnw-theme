{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!assets/netnewswire",
			"!assets/footnotes.js",
			"!test/fixtures/**/*.nnwtheme"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 96
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noControlCharactersInRegex": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
